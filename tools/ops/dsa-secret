#!/usr/bin/env bash
set -eo pipefail

SECRETS_FILE="${DSART_SECRETS_FILE:-$HOME/.dsart/secrets.env}"

usage() {
  cat <<'EOF'
Usage: dsa-secret <name>
       dsa-secret list
       dsa-secret --help

Retrieve a secret value from the local secrets file.

  dsa-secret list      List available secret names (values hidden).
  dsa-secret <name>    Print the value for <name> (case-insensitive; matches
                       the env var name with or without common suffixes,
                       e.g. 'dsa-secret grafana' matches GRAFANA_AUTH).
                       Prints the value only, no trailing newline decoration,
                       so it is pipeable.
  dsa-secret --help    Show this help.

Note: secrets live only in ~/.dsart/secrets.env on h23; never commit or
paste them in Slack/docs.
EOF
}

check_file() {
  if [[ ! -f "$SECRETS_FILE" ]]; then
    echo "dsa-secret: secrets file not found: $SECRETS_FILE" >&2
    echo "dsa-secret: create it (chmod 600) or set DSART_SECRETS_FILE to its location." >&2
    exit 1
  fi
  if [[ ! -r "$SECRETS_FILE" ]]; then
    echo "dsa-secret: secrets file not readable: $SECRETS_FILE (check ownership/permissions)" >&2
    exit 1
  fi
  local perms
  perms="$(stat -c '%a' "$SECRETS_FILE" 2>/dev/null || stat -f '%Lp' "$SECRETS_FILE" 2>/dev/null || true)"
  if [[ -n "$perms" && "$perms" != "600" ]]; then
    echo "dsa-secret: warning: $SECRETS_FILE has permissions $perms (expected 600); fix with: chmod 600 $SECRETS_FILE" >&2
  fi
}

# Emit KEY<TAB>VALUE for lines of the form:
#   export KEY='value'   or   KEY=value   (single/double/no quotes)
parse_entries() {
  grep -E "^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=" "$SECRETS_FILE" | while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#export }"
    line="${line#"${line%%[![:space:]]*}"}"
    key="${line%%=*}"
    val="${line#*=}"
    if [[ "$val" == \'*\' && ${#val} -ge 2 ]]; then
      val="${val#\'}"; val="${val%\'}"
    elif [[ "$val" == \"*\" && ${#val} -ge 2 ]]; then
      val="${val#\"}"; val="${val%\"}"
    fi
    printf '%s\t%s\n' "$key" "$val"
  done
}

cmd_list() {
  parse_entries | cut -f1 | tr '[:upper:]' '[:lower:]' | sort -u
}

cmd_get() {
  local query uquery matched_val="" matched=0
  query="$1"
  uquery="$(printf '%s' "$query" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
  while IFS=$'\t' read -r key val; do
    if [[ "$key" == "$uquery" || "$key" == "${uquery}_"* ]]; then
      matched_val="$val"
      matched=$((matched + 1))
    fi
  done < <(parse_entries)

  if (( matched == 0 )); then
    echo "dsa-secret: no secret matching '$query' in $SECRETS_FILE" >&2
    echo "dsa-secret: run 'dsa-secret list' to see available names." >&2
    exit 1
  fi
  if (( matched > 1 )); then
    echo "dsa-secret: warning: '$query' matched $matched keys; using the last match" >&2
  fi
  printf '%s' "$matched_val"
}

if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

check_file

case "$1" in
  list) cmd_list ;;
  *)    cmd_get "$1" ;;
esac
