      "id": 1,
      "type": "graph",
      "title": "corr_rt heartbeat \u2014 alive per cn",
      "datasource": "InfluxDB",
      "description": "1 = control plane saw a heartbeat for that cn in the last bucket. 0/null = stale; per /mon/service/corr_rt cadence is 2 s, so any gap >5 s is meaningful.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "alias": "cn $tag_cn_id",
          "policy": "default",
          "resultFormat": "time_series",
          "orderByTime": "ASC",
          "rawQuery": true,
          "query": "SELECT last(\"alive\") FROM \"corr_rt_heartbeat\" WHERE $timeFilter GROUP BY time($__interval), \"cn_id\" fill(null)",
