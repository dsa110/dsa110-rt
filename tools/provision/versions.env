# Pinned versions for a corr/search node rebuild.
#
# Every value here was read off a running node (n03 corr, n01 search) on
# 2026-08-01 rather than chosen. Changing one means the rebuilt node no
# longer matches the fleet, so treat this file as the contract and bump
# it deliberately.
#
# The single most important pin is CUDA. The legacy cloud-init did
# `apt-get -y install cuda`, which installs whatever is current in the
# NVIDIA repo -- on a rebuild today that is several major versions ahead
# of what the compiled extensions and dsaX binaries were built against.

# ---- OS ------------------------------------------------------------
# 18.04 is EOL (ESM only). Kept because the whole stack is validated
# against it; an OS bump is a separate project, not a rebuild.
OS_RELEASE="18.04"
OS_CODENAME="bionic"
KERNEL_PIN="4.15.0-213-generic"        # advisory: what the fleet runs

# ---- GPU -------------------------------------------------------------
CUDA_VERSION="11.1"
CUDA_APT_PKG="cuda-11-1"               # NOT bare "cuda" -- that floats
NVIDIA_DRIVER_VERSION="525.105.17"
NVIDIA_APT_PKG="cuda-drivers-525"
GPU_MODEL="NVIDIA GeForce RTX 2080 Ti" # 2 per node, 11264 MiB each

# ---- toolchain -------------------------------------------------------
GCC_VERSION="7"                        # CUDA 11.1 will not accept gcc >= 10

# ---- python ----------------------------------------------------------
# dsart runs from miniforge3, NOT the legacy anaconda3. Both are present
# on a live node: anaconda3 carries casa38 for the calibration tooling.
MINIFORGE_INSTALLER="Miniforge3-Linux-x86_64.sh"
MINIFORGE_PREFIX="/home/ubuntu/miniforge3"
DSART_ENV_NAME="dsa110-rt"
DSART_ENV_YML="envs/dsa110-rt.yml"     # relative to the dsa110-rt repo
ANACONDA_INSTALLER="Anaconda3-2020.02-Linux-x86_64.sh"
ANACONDA_PREFIX="/home/ubuntu/anaconda3"
INSTALL_ANACONDA="no"                  # legacy casa38; not needed for dsart

# ---- repos -----------------------------------------------------------
PROJ_DIR="/home/ubuntu/proj"
SHELL_REPO="https://github.com/dsa110/dsa110-shell.git"
RT_REPO="https://github.com/dsa110/dsa110-rt.git"
RT_BRANCH="main"
PSRDADA_PIN="72f07e9"                  # dsa110-psrdada HEAD on the fleet

# ---- MaaS fileserver -------------------------------------------------
# Literal IP on purpose. The legacy scripts mixed this with
# http://lxd110maas.ovro.pvt/, and neither lxd110maas.ovro.pvt nor
# .pro.pvt resolves from the observatory hosts -- only ".pro.pvt" names
# that MaaS publishes as dnsresources are served. A name that does not
# resolve turns a provisioning step into a silent no-op.
WEB_MAAS="http://10.42.0.3/maas"

# ---- kernel tuning ---------------------------------------------------
# Matches config/sysctl/set_sysctl already on the MaaS fileserver, which
# in turn matches the live nodes. Restated here so verify_node.sh has a
# single source of truth to assert against.
SYSCTL_RMEM_MAX="536870912"
SYSCTL_WMEM_MAX="536870912"
SYSCTL_RMEM_DEFAULT="16777216"
SYSCTL_NETDEV_BACKLOG="250000"
SYSCTL_SHMMAX="68719476736"
SYSCTL_SHMALL="4294967296"

# ---- fabric ----------------------------------------------------------
DATA_MTU="9000"
DATA_SUBNET="10.41.0"
MGMT_SUBNET="10.42.0"
# corr nodes carry the data fabric on the raw Mellanox port; search nodes
# carry it on a bridge. Detected at run time, listed here for verify.
CORR_DATA_IFACE_HINT="enp129s0f0"
SEARCH_DATA_IFACE_HINT="br2"

# ---- role-specific ---------------------------------------------------
SEARCH_DM_PLAN_DIR="/home/ubuntu/data/dm_plans"
SEARCH_DM_PLAN="dm_plan_N8_dmmin100_tol1.364_csf8_cap10.2_v3.1.npz"
