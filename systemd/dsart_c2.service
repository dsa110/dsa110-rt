[Unit]
Description=DSA-110 dsart-rt C2 coincidencer (h23)
Documentation=file:/home/ubuntu/vikram/dev/dsa110-rt/docs/c1c2/C1C2_DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs under the operator user; the casa38 conda env provides
# event.names + dsautils + slack_sdk (same env legacy T2 ran in).
WorkingDirectory=/home/ubuntu/vikram/dev/dsa110-rt
ExecStart=/home/ubuntu/anaconda3/envs/dsart_h23/bin/python -u -m dsart.services.coincidencer --config /home/ubuntu/vikram/dev/dsa110-rt/configs/dsart_search_rt.yaml
Environment=PYTHONPATH=/home/ubuntu/vikram/dev/dsa110-rt/src
Environment=PATH=/home/ubuntu/anaconda3/envs/dsart_h23/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=MPLBACKEND=Agg
# Keep BLAS/OpenMP thread pools small so a coincidencer + 2 plotter
# workers cannot starve the box. C2 work is light (a few hundred
# rows/sec at production rate) so single-threaded BLAS is sufficient.
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
# SIGHUP triggers in-process criteria reload (see services/coincidencer.py).
KillMode=mixed

# Resource caps: leave nproc unset (inherit user-slice default) so
# OpenBLAS/matplotlib pools can grow if needed; only cap open files.
LimitNOFILE=16384

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsart_c2

[Install]
WantedBy=default.target
